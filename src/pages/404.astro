---
import BaseLayout from "../layouts/BaseLayout.astro";
import Board from "../components/Board.astro";
import { getPublishedWork } from "../lib/work-data";

const projects = await getPublishedWork();
---

<BaseLayout
  title="Not found | Diego Temkin"
  description="This page was not found."
>
  <main id="content" class="wrapper">
    <Board projects={projects}>
      <Fragment slot="top">
        <h1 class="alert">This stop is not in service</h1>
        <p class="alert-note">
          This page doesn't exist or has moved. Choose another stop below.
        </p>
      </Fragment>
    </Board>
  </main>
</BaseLayout>
