---
import { Image } from "astro:assets";

import BaseLayout from "../layouts/BaseLayout.astro";
import StripMap from "../components/StripMap.astro";
import portrait from "../assets/portrait.jpg";
---

<BaseLayout title="About | Diego Temkin" description="About Diego Temkin">
  <main class="wrapper about">
    <h1>About</h1>

    <div class="intro">
      <div class="prose">
        <p>
          I'm a first-year MS Transportation student at MIT and a Graduate
          Research Assistant in the JTL-Transit Lab. I'm interested in urban
          mobility, transit network optimization, and transit data systems,
          with a focus on improving access to public transportation in
          underserved communities.
        </p>
        <p>
          I'm from the Rio Grande Valley in South Texas, right along the
          US-Mexico border. My parents both immigrated to the US from Mexico. I
          attended the Science Academy of South Texas, a STEM magnet school, and
          tutored children from all grades in math, including virtually through
          the COVID-19 pandemic.
        </p>
      </div>
      <Image
        src={portrait}
        widths={[320, 640]}
        sizes="(max-width: 48rem) 100vw, 20rem"
        alt="Diego Temkin smiling in a blue button-down shirt in front of a marble column"
        loading="eager"
      />
    </div>

    <section>
      <h2>The route so far</h2>
      <StripMap />
    </section>

    <section class="prose">
      <h2>Education</h2>
      <p>MS in Transportation, MIT, expected 2028.</p>
      <p>
        BS in Computer Science and Engineering and in Planning, MIT, 2026. My
        thesis received the MIT DUSP Best Undergraduate Thesis award.
      </p>
      <p>The Science Academy of South Texas, 2022.</p>
    </section>

    <section class="prose">
      <h2>Publications</h2>
      <p>
        <a href="https://dspace.mit.edu/handle/1721.1/176348"
          ><cite
            >A Co-Design Framework for School Bus Network Redesign: Applying
            Category Theory to Routing, Resources, and Equity</cite
          ></a
        >. Bachelor's thesis, MIT, May 2026.
      </p>
      <p>
        <a href="https://doi.org/10.1016/B978-0-443-21782-1.00008-7"
          >NbS and policy communication</a
        >. With Cong Cong. In <cite
          >Nature-Based Solutions in Supporting Sustainable Development Goals</cite
        >, November 2024.
      </p>
    </section>

    <section class="prose">
      <h2>On campus</h2>
      <p>
        I'm a Student Developer and Member-at-Large at SIPB, MIT's student
        computing club, and I help maintain Hydrant and CourseRoad, which
        students use to plan their classes.
      </p>
      <p>
        I was President of Dormitory Council from 2025 to 2026, representing over
        3,500 undergraduates.
      </p>
    </section>

    <section class="prose">
      <h2>Skills and honors</h2>
      <p>
        Python, TypeScript, Java, C, C#, SQL, Go, and GIS. English and Spanish,
        both native.
      </p>
      <p>
        MIT Karl Taylor Compton Prize, QuestBridge NCM Scholar, HSF Scholar,
        National Hispanic Scholar, National Rural and Small Town Scholar, and AP
        Scholar with Distinction.
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: 3rem;
  }

  .intro {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  img {
    width: 100%;
    max-width: 20rem;
    border-radius: 6px;
  }

  section > h2 {
    margin-bottom: 1rem;
  }

  section.prose > h2 {
    margin-top: 0;
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: 1fr 20rem;
    }
  }
</style>
