---
import BaseLayout from "../layouts/BaseLayout.astro";
import Board from "../components/Board.astro";
import { getPublishedWork } from "../lib/work-data";

const projects = await getPublishedWork();
---

<BaseLayout>
  <main id="content" tabindex="-1" class="wrapper">
    <Board projects={projects} />
  </main>
</BaseLayout>
