---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Board from "../../components/Board.astro";
import { getPublishedWork } from "../../lib/work-data";

const projects = await getPublishedWork();
---

<BaseLayout
  title="All stops | Diego Temkin"
  description="Every project Diego Temkin has worked on, newest first."
>
  <main id="content" class="wrapper">
    <h1>All stops</h1>
    <Board projects={projects} />
  </main>
</BaseLayout>

<style>
  h1 {
    margin-bottom: 1rem;
  }
</style>
