---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { timeLabel } from "../../lib/work";
import { getPublishedWork } from "../../lib/work-data";

interface Props {
  entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
const isPortrait = data.img ? data.img.height > data.img.width : false;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={{
    src: `/og/${entry.id}.png`,
    alt: `Diego Temkin's site: the countdown board showing ${data.title}, ${timeLabel(data)}`,
  }}
>
  <main id="content" class="wrapper">
    <header>
      <div class="heading">
        <h1>{data.title}</h1>
        <p class="time">{timeLabel(data)}</p>
      </div>
      {data.status === "in-development" && <p class="status">In development</p>}
      <p class="description">{data.description}</p>
      {data.tags.length > 0 && <p class="tags">{data.tags.join(", ")}</p>}
    </header>

    <div
      class:list={[
        "content",
        { split: isPortrait && hasBody, solo: isPortrait && !hasBody },
      ]}
    >
      {data.img && (
        <Image
          src={data.img}
          alt={data.img_alt || ""}
          width={Math.min(data.img.width, isPortrait ? 720 : 992)}
          widths={isPortrait ? [320, 540, 720] : [400, 540, 800, 992]}
          quality={70}
          fetchpriority="high"
          sizes={
            isPortrait && hasBody
              ? "(min-width: 48rem) 18rem, 100vw"
              : "(max-width: 62rem) 100vw, 62rem"
          }
          loading="eager"
        />
      )}

      {hasBody && (
        <div class="notice prose body">
          <Content />
        </div>
      )}
    </div>

    <p class="back">
      <a href={`/#${entry.id}`}>Back to the board</a>
    </p>
  </main>
</BaseLayout>

<style>
  header {
    padding: clamp(0.875rem, 2.5vw, 1.5rem);
    border-radius: 6px;
    background: var(--board);
    color: var(--readout);
    font-size: 1rem;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1.5rem;
    color: var(--yellow);
    font-family: var(--font-led);
    font-size: var(--text-led);
    font-weight: 900;
    line-height: 1.3;
  }

  h1 {
    flex: 1 1 16rem;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .time {
    white-space: nowrap;
  }

  .status,
  .description,
  .tags {
    margin-top: 0.5rem;
    max-width: 72ch;
  }

  .status {
    color: var(--yellow);
  }

  .tags {
    color: var(--placeholder);
    font-size: var(--text-small);
  }

  img {
    width: 100%;
    margin-top: 1.5rem;
  }

  /* A portrait photo with no text beside it would be huge at full width. */
  .solo img {
    width: auto;
    max-height: 36rem;
  }

  .body {
    margin-top: 2rem;
  }

  /* Portrait photos sit beside the text, so they don't leave a blank column. */
  @media (min-width: 48rem) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: 1.5rem;
      align-items: start;
      margin-top: 1.5rem;
    }

    .split img {
      grid-area: 1 / 2;
      width: 100%;
      max-height: none;
      margin-top: 0;
    }

    .split .body {
      grid-area: 1 / 1;
      margin-top: 0;
    }
  }

  .back {
    margin-top: 1.5rem;
  }

  @media (pointer: coarse), (max-width: 36rem) {
    .back a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
