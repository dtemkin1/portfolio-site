---
import { Image } from "astro:assets";
import { type CollectionEntry, getEntries, render } from "astro:content";

import Notes from "../../components/Notes.astro";
import Publications from "../../components/Publications.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNotes } from "../../lib/notes";
import { onHomeBoard, timeLabel } from "../../lib/work";
import { getWorkPages } from "../../lib/work-data";

interface Props {
  entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
  const work = await getWorkPages();
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());

const publications = await getEntries(data.publications ?? []);
const missing = (data.publications ?? []).filter((_, i) => !publications[i]);
if (missing.length) {
  throw new Error(
    `${entry.id}: ${missing.map(({ id }) => id).join(", ")} isn't the BibTeX key of any public work on ORCID. Check the key, and that the work's visibility is "Everyone".`,
  );
}
const notes = (await getNotes()).filter(
  ({ data }) => data.project?.id === entry.id,
);
const isPortrait = data.img && data.img.src.height > data.img.src.width;
---

<BaseLayout
  title={data.title}
  description={data.description}
  image={{
    src: `/og/${entry.id}.png`,
    alt: `Diego Temkin's site: the countdown board showing ${data.title}, ${timeLabel(data)}`,
  }}
>
  <main id="content" class="wrapper">
    <header>
      <div class="heading">
        <h1>{data.title}</h1>
        <p class="time">{timeLabel(data)}</p>
      </div>
      {data.inDevelopment && <p class="status">In development</p>}
      <p class="description">{data.description}</p>
      {data.tags.length > 0 && <p class="tags">{data.tags.join(", ")}</p>}
      {(data.links ?? []).length > 0 && (
        <ul class="links">
          {data.links!.map(({ label, url }) => (
            <li>
              <a href={url}>{label}</a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div
      class:list={[
        "content",
        { split: isPortrait && hasBody, solo: isPortrait && !hasBody },
      ]}
    >
      {data.img && (
        <Image
          src={data.img.src}
          alt={data.img.alt}
          width={Math.min(data.img.src.width, isPortrait ? 720 : 992)}
          widths={isPortrait ? [320, 540, 720] : [400, 540, 800, 992]}
          quality={70}
          fetchpriority="high"
          sizes={
            isPortrait && hasBody
              ? "(min-width: 48rem) 18rem, 100vw"
              : "(max-width: 62rem) 100vw, 62rem"
          }
          loading="eager"
        />
      )}

      {hasBody && (
        <div class="notice prose body">
          <Content />
        </div>
      )}
    </div>

    {publications.length > 0 && (
      <section class="notice prose writing">
        <h2>Publications and presentations</h2>
        <Publications entries={publications} />
      </section>
    )}

    {notes.length > 0 && (
      <section class="notice prose writing">
        <h2>Elsewhere</h2>
        <Notes entries={notes} />
      </section>
    )}

    <p class="back">
      <a href={onHomeBoard(entry) ? `/#${entry.id}` : `/work/#${entry.id}`}>
        Back to the board
      </a>
    </p>
  </main>
</BaseLayout>

<style>
  header {
    padding: clamp(0.875rem, 2.5vw, 1.5rem);
    border-radius: 6px;
    background: var(--board);
    color: var(--readout);
    font-size: 1rem;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1.5rem;
    color: var(--yellow);
    font-family: var(--font-led);
    font-size: var(--text-led);
    font-weight: 900;
    line-height: 1.3;
  }

  h1 {
    flex: 1 1 16rem;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .time {
    white-space: nowrap;
  }

  .status,
  .description,
  .tags {
    margin-top: 0.5rem;
    max-width: 65ch;
  }

  .status {
    color: var(--yellow);
  }

  .tags {
    color: var(--placeholder);
    font-size: var(--text-small);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  img {
    width: 100%;
    margin-top: 1.5rem;
  }

  /* A portrait photo with no text beside it would be huge at full width. */
  .solo img {
    width: auto;
    max-height: 36rem;
    margin-inline: auto;
  }

  .body {
    margin-top: 2rem;
  }

  /* Portrait photos sit beside the text, so they don't leave a blank column. */
  @media (min-width: 48rem) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 18rem;
      gap: 1.5rem;
      align-items: start;
      margin-top: 1.5rem;
    }

    .split img {
      grid-area: 1 / 2;
      width: 100%;
      max-height: none;
      margin-top: 0;
    }

    .split .body {
      grid-area: 1 / 1;
      margin-top: 0;
    }
  }

  .writing {
    margin-top: 2rem;
  }

  .writing > h2 {
    margin-top: 0;
  }

  .back {
    margin-top: 1.5rem;
  }

  @media (pointer: coarse), (max-width: 36rem) {
    .back a,
    .links a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
