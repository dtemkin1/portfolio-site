---
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { timeLabel } from "../../lib/work";
import { getPublishedWork } from "../../lib/work-data";

interface Props {
  entry: CollectionEntry<"work">;
}

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasBody = Boolean(entry.body?.trim());
---

<BaseLayout
  title={`${data.title} | Diego Temkin`}
  description={data.description}
>
  <main id="content" tabindex="-1" class="wrapper">
    <header>
      <div class="heading">
        <h1>{data.title}</h1>
        <p class="time">{timeLabel(data)}</p>
      </div>
      {data.status === "in-development" && <p class="status">In development</p>}
      <p class="description">{data.description}</p>
      {data.tags.length > 0 && <p class="tags">{data.tags.join(", ")}</p>}
    </header>

    {data.img && (
      <Image
        src={data.img}
        alt={data.img_alt || ""}
        widths={[540, 720, 992]}
        sizes="(max-width: 62rem) 100vw, 62rem"
        loading="eager"
      />
    )}

    {hasBody && (
      <div class="notice prose body">
        <Content />
      </div>
    )}

    <p class="back">
      <a href={`/#${entry.id}`}>Back to the board</a>
    </p>
  </main>
</BaseLayout>

<style>
  header {
    padding: clamp(0.875rem, 2.5vw, 1.5rem);
    border-radius: 6px;
    background: var(--board);
    color: var(--readout);
    font-size: 1rem;
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 1.5rem;
    color: var(--yellow);
    font-family: var(--font-led);
    font-size: var(--text-led);
    font-weight: 900;
    line-height: 1.3;
  }

  h1 {
    flex: 1 1 16rem;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
  }

  .time {
    white-space: nowrap;
  }

  .status,
  .description,
  .tags {
    margin-top: 0.5rem;
    max-width: 72ch;
  }

  .status {
    color: var(--yellow);
  }

  img {
    width: 100%;
    max-height: 28rem;
    margin-top: 1.5rem;
    border-radius: 6px;
    object-fit: cover;
  }

  .body {
    margin-top: 2rem;
  }

  .back {
    margin-top: 1.5rem;
  }

  @media (pointer: coarse), (max-width: 36rem) {
    .back a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }
</style>
