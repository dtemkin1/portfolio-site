---
const stops = ["McAllen, TX", "MIT", "WMATA", "JTL-Transit Lab"];
---

<figure>
  <ol aria-label="Route so far, from McAllen, Texas to the JTL-Transit Lab">
    {stops.map((stop) => (
      <li>{stop}</li>
    ))}
  </ol>
</figure>

<style>
  figure {
    margin: 0;
  }

  /* One line, drawn from CSS so the labels stay real, readable text. */
  ol {
    --dot: 1.25rem;
    --track: 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    position: relative;
    padding-top: calc(var(--dot) + 0.5rem);
    font-weight: 800;
  }

  li::before {
    content: "";
    position: absolute;
    top: calc((var(--dot) - var(--track)) / 2);
    left: 0;
    right: 0;
    height: var(--track);
    background: var(--yellow);
  }

  li::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: var(--dot);
    height: var(--dot);
    border: 3px solid var(--board);
    border-radius: 50%;
    background: var(--white);
  }

  li:last-child::before {
    right: auto;
    width: var(--dot);
  }

  @media (max-width: 37.5rem) {
    ol {
      grid-auto-flow: row;
    }

    li {
      padding: 0 0 1rem calc(var(--dot) + 0.75rem);
    }

    li::before {
      top: 0;
      bottom: 0;
      left: calc((var(--dot) - var(--track)) / 2);
      right: auto;
      width: var(--track);
      height: auto;
    }

    li:last-child::before {
      bottom: auto;
      width: var(--track);
      height: var(--dot);
    }
  }

  @media (forced-colors: active) {
    li::before {
      background: CanvasText;
    }

    li::after {
      background: Canvas;
      border-color: CanvasText;
    }
  }
</style>
