---
const currentYear = new Date().getFullYear();

const links = [
  { label: "Bluesky", href: "https://bsky.app/profile/dtemkin1.bsky.social" },
  { label: "Twitter", href: "https://twitter.com/dtemkin1" },
  { label: "Instagram", href: "https://www.instagram.com/dtemkin1/" },
  { label: "MIT Athena", href: "https://web.mit.edu/dtemkin/www/" },
  { label: "RSS", href: "/rss.xml" },
  { label: "Admin", href: "/admin/" },
];
---

<footer>
  <div class="edge" aria-hidden="true"></div>
  <div class="wrapper inner">
    <p>&copy; {currentYear} Diego Temkin. Built with Astro in Cambridge, MA.</p>
    <ul>
      {links.map(({ label, href }) => (
        <li>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  /* The tactile warning strip at the edge of a train platform. */
  .edge {
    height: 1.5rem;
    background-color: var(--yellow);
    background-image: radial-gradient(
      circle,
      rgb(23 19 11 / 0.35) 0.25rem,
      transparent 0.28rem
    );
    background-size: 1rem 1rem;
    background-position: center;
  }

  footer {
    background: var(--board);
    color: var(--readout);
    font-size: var(--text-small);
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.25rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (pointer: coarse), (max-width: 36rem) {
    ul {
      gap: 0 1rem;
    }

    li a {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-width: 44px;
      min-height: 44px;
    }
  }
</style>
