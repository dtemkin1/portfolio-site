---
// One CV entry: what and where on the left, place and dates on the right, then the details.
interface Props {
  heading: string;
  // the organization's own page about the role, if there is one
  href?: string | undefined;
  // the role, or the school, on the line under the heading
  sub?: string | undefined;
  place?: string | undefined;
  dates: string;
  summary?: string | undefined;
  points?: string[];
  // this site's page about the work
  project?: { title: string; href: string } | undefined;
}

const {
  heading,
  href,
  sub,
  place,
  dates,
  summary,
  points = [],
  project,
} = Astro.props;
---

<div class="entry">
  <div class="head">
    <h3>
      {href ? <a href={href}>{heading}</a> : heading}
      {sub && <span class="sub">{sub}</span>}
    </h3>
    <p class="when">
      {place && <span>{place}</span>}
      <span>{dates}</span>
    </p>
  </div>
  {summary && <p>{summary}</p>}
  {points.length > 0 && (
    <ul>
      {points.map((point) => (
        <li>{point}</li>
      ))}
    </ul>
  )}
  {project && (
    <p class="project">
      Project: <a href={project.href}>{project.title}</a>
    </p>
  )}
</div>

<style>
  .entry + .entry {
    margin-top: 1.5rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  h3 {
    flex: 1 1 22rem;
    font-size: 1.125rem;
    line-height: 1.35;
  }

  /* black like the other headings; the underline shows it's a link, since touch screens have no hover */
  h3 a {
    color: inherit;
  }

  /* the role or school, in italics so the heading leads */
  .sub {
    display: block;
    font-style: italic;
    font-weight: 500;
  }

  .when {
    display: flex;
    flex-direction: column;
    font-size: var(--text-small);
    text-align: right;
  }

  ul {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  li + li {
    margin-top: 0.25rem;
  }

  .entry > p,
  li {
    max-width: 70ch;
  }

  .entry > p {
    margin-top: 0.5rem;
  }

  /* small, like the project lines under the publications */
  .project {
    font-size: var(--text-small);
  }

  @media (pointer: coarse), (max-width: 36rem) {
    h3 a,
    .project a {
      padding-block: 0.85rem;
      margin-block: -0.85rem;
    }
  }

  /* Once the head wraps, the dates sit under the heading, so they line up with it. */
  @media (max-width: 36rem) {
    .when {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 1rem;
      text-align: left;
    }
  }

  @media print {
    .head {
      break-after: avoid;
    }

    .entry > p,
    li {
      break-inside: avoid;
    }

    .entry + .entry {
      margin-top: 0.55rem;
    }

    h3 {
      font-size: 10pt;
    }

    /* the link still works in the PDF, so its address isn't printed */
    h3 a::after {
      content: none !important;
    }

    /* paper leaves out the site's own pages, as it does under the publications */
    .project {
      display: none;
    }

    .when {
      color: var(--print-grey) !important;
      font-size: 9pt;
    }

    ul {
      margin-top: 0.2rem;
    }

    li + li {
      margin-top: 0.1rem;
    }

    .entry > p {
      margin-top: 0.2rem;
    }
  }
</style>
