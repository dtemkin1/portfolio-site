---
import type { CollectionEntry } from "astro:content";

import CopyButton from "./CopyButton.astro";

import {
  coauthors,
  dateLabel,
  link,
  newestFirst,
  parseName,
  venue,
  venueLine,
} from "../lib/content/publications";
import { SITE, shortAddress } from "../lib/site";

interface Props {
  entries: CollectionEntry<"publications">[];
  // the date in its own column, like the CV's other entries
  dated?: boolean;
}

const { entries, dated = false } = Astro.props;

const self = parseName(SITE.name);
const names = new Intl.ListFormat("en", { type: "conjunction" });

const list = newestFirst(entries.map(({ id, data }) => ({ id, ...data }))).map(
  (publication) => {
    const authors = coauthors(publication, self);
    const mine = new Set(authors.filter(([, me]) => me).map(([name]) => name));
    const href = link(publication);
    return {
      id: publication.id,
      bibtex: publication.bibtex,
      title: publication.title,
      href,
      address: href && shortAddress(href),
      // "A, B, and C" with my name picked out
      authors: names
        .formatToParts(authors.map(([name]) => name))
        .map(({ type, value }) => ({
          value,
          me: type === "element" && mine.has(value),
        })),
      venue: dated ? venue(publication) : venueLine(publication),
      date: dateLabel(publication),
      // the CV lists honors in their own section, so notes (like an award) stay on the work pages
      note: dated ? undefined : publication.note,
    };
  },
);
---

<ul class:list={["entries", { dated }]}>
  {list.map((item) => {
    const title = item.href ? (
      <a class="title" href={item.href}>
        {item.title}
      </a>
    ) : (
      <span class="title">{item.title}</span>
    );
    return (
      <li>
        {dated ? (
          <div class="head">
            {title}
            <span class="when">{item.date}</span>
          </div>
        ) : (
          title
        )}
        {item.authors.length > 0 && (
          <span class="aside">
            {item.authors.map(({ value, me }) =>
              me ? <strong>{value}</strong> : value,
            )}
          </span>
        )}
        <span class="aside venue">{item.venue}</span>
        {item.note && <span class="aside">{item.note}</span>}
        {item.address && <span class="aside address">{item.address}</span>}
        {item.bibtex && (
          <details class="aside">
            <summary>BibTeX</summary>
            <pre id={`bibtex-${item.id}`}>{item.bibtex}</pre>
            <CopyButton target={`bibtex-${item.id}`} label="Copy BibTeX" />
          </details>
        )}
      </li>
    );
  })}
</ul>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1.5rem;
  }

  .dated {
    margin-top: 0;
  }

  /* on the CV, a title reads like the other entry headings */
  .dated .title {
    flex: 1 1 22rem;
    color: var(--sign-ink);
    font-weight: 700;
    text-decoration: none;
  }

  .dated a.title:hover,
  .dated a.title:focus-visible {
    text-decoration: underline;
  }

  /* and its lines match the other entries' second lines */
  .dated .aside {
    font-size: inherit;
  }

  /* the venue in italics, like the other entries' second line */
  .dated .venue {
    font-style: italic;
  }

  /* the BibTeX toggle stays small, as an extra */
  .dated details.aside {
    font-size: var(--text-small);
  }

  .when {
    font-size: var(--text-small);
  }

  /* only for paper, where the title can't be clicked */
  .entries .address {
    display: none;
  }

  summary {
    width: fit-content;
    cursor: pointer;
  }

  pre {
    margin: 0.5rem 0 0;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.5;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    tab-size: 2;
  }

  @media (pointer: coarse), (max-width: 36rem) {
    /* padding, not flex, so the toggle keeps its arrow */
    summary {
      padding-block: 0.75rem;
    }
  }

  /* .entries .aside is display: block, so these need the extra class to win */
  @media print {
    details.aside {
      display: none;
    }

    .entries .address {
      display: block;
      overflow-wrap: anywhere;
    }

    /* the address line replaces the URL that print adds after links */
    .title::after {
      content: none !important;
    }

    .entries {
      break-inside: auto;
    }

    .dated .title {
      font-size: 10pt;
    }

    /* dates and link addresses in grey, like the other entries' dates */
    .dated .when,
    .dated .address {
      color: var(--print-grey) !important;
      font-size: 9pt;
    }

    .dated > li + li {
      margin-top: 0.55rem;
    }

    .dated .aside {
      margin-top: 0.1rem;
    }

    li {
      break-inside: avoid;
    }
  }
</style>
