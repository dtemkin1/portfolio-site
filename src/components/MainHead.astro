---
import "@fontsource/overpass/500.css";
import "@fontsource/overpass/800.css";
import "@fontsource/overpass-mono/400.css";
import "@fontsource/doto/700.css";
import "@fontsource/doto/900.css";

import "../styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const {
  title = "Diego Temkin",
  description = "Diego Temkin is an MS in Transportation student at MIT and a graduate research assistant in the JTL-Transit Lab.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL("/og.png", Astro.site).href;

const mit = {
  "@type": "CollegeOrUniversity",
  name: "Massachusetts Institute of Technology",
};
const person = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Diego Temkin",
  url: Astro.site?.href,
  description:
    "MS in Transportation student at MIT, researching how students ride transit.",
  affiliation: mit,
  alumniOf: mit,
  sameAs: [
    "https://github.com/dtemkin1",
    "https://www.linkedin.com/in/diego-temkin/",
    "https://bsky.app/profile/dtemkin1.bsky.social",
  ],
});
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
  property="og:image:alt"
  content="Diego Temkin's site: a station sign above a countdown board listing research projects"
/>
<meta name="twitter:card" content="summary_large_image" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#003da5" />
<title>{title}</title>

<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed for Diego Temkin's website"
  href="/rss.xml"
/>

{Astro.url.pathname === "/" && (
  <script is:inline type="application/ld+json" set:html={person} />
)}
