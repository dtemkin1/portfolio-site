---
import { Font } from "astro:assets";

import { NIGHT_KEY } from "../lib/live";
import { COLORS, PROFILES, SITE, pageTitle } from "../lib/site";
import "../styles/global.css";

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  image?: { src: string; alt: string } | undefined;
}

const {
  title,
  description = "Diego Temkin is an SM in Transportation student at MIT and a graduate research assistant in the JTL-Transit Lab.",
  image = {
    src: "/og.png",
    alt: "Diego Temkin's site: a station sign above a countdown board listing research projects",
  },
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image.src, Astro.site).href;

const mit = {
  "@type": "CollegeOrUniversity",
  name: "Massachusetts Institute of Technology",
};
const person = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.name,
  url: Astro.site?.href,
  description: SITE.tagline,
  affiliation: mit,
  alumniOf: mit,
  sameAs: Object.values(PROFILES),
});
---

<meta charset="UTF-8" />
<meta name="description" content={description} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="viewport" content="width=device-width" />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content={COLORS.wall} />

<script is:inline define:vars={{ key: NIGHT_KEY }}>
  try {
    if (Number(sessionStorage.getItem(key)) > Date.now()) {
      document.documentElement.setAttribute("data-night", "");
    }
  } catch {
    // page starts normally
  }
</script>
<title>{fullTitle}</title>

<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="RSS Feed for Diego Temkin's website"
  href={new URL("rss.xml", Astro.site)}
/>

<Font cssVariable="--font-overpass" preload />
<Font cssVariable="--font-overpass-mono" />
<Font cssVariable="--font-doto" />

{Astro.url.pathname === "/" && (
  <script is:inline type="application/ld+json" set:html={person} />
)}
