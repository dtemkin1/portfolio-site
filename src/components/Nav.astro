---
const isHome = Astro.url.pathname === "/";

const links = [
  { label: "About", href: "/about/" },
  { label: "CV", href: "https://cv.diegotemkin.com/Diego_Temkin_CV.pdf" },
  { label: "GitHub", href: "https://github.com/dtemkin1" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/diego-temkin/" },
  { label: "Email", href: "mailto:dtemkin@mit.edu" },
];
---

<header class:list={["wrapper station", { compact: !isHome }]}>
  {isHome ? (
    <h1 class="sign">Diego Temkin</h1>
  ) : (
    <a class="sign" href="/">
      Diego Temkin
    </a>
  )}
  {isHome && (
    <p class="line">
      MS in Transportation student at MIT, researching how students ride
      transit.
    </p>
  )}
  <nav aria-label="Main">
    <ul>
      {/* each link has its own transition name, so it travels to its spot on the next page. */}
      {links.map(({ label, href }) => (
        <li style={`view-transition-name: nav-${label.toLowerCase()}`}>
          <a href={href}>{label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  .station {
    padding-block: clamp(1.5rem, 5vw, 3.5rem) 0;
  }

  .sign {
    display: block;
    width: fit-content;
    font-size: var(--text-sign);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
    view-transition-name: sign;
  }

  .line {
    margin-top: 0.5rem;
    view-transition-name: tagline;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  li a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    padding-block: 0.25rem;
  }

  .compact {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: 1rem 0;
  }

  .compact .sign {
    font-size: var(--text-h2);
    letter-spacing: 0;
  }

  .compact ul {
    margin-top: 0;
  }

  @media (pointer: coarse), (max-width: 36rem) {
    ul {
      gap: 0 0.5rem;
    }

    li a {
      min-width: 44px;
      min-height: 44px;
    }

    .compact .sign {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
    }
  }

  @media (max-width: 22.5rem) {
    ul {
      gap: 0 0.25rem;
      font-size: 1rem;
    }
  }
</style>
