---
const isHome = Astro.url.pathname === "/";

const links = [
  { label: "About", href: "/about/" },
  { label: "CV", href: "https://cv.diegotemkin.com" },
  { label: "GitHub", href: "https://github.com/dtemkin1" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/diego-temkin/" },
  { label: "Email", href: "mailto:dtemkin@mit.edu" },
];
---

<header class="wrapper station">
  {
    isHome ? (
      <h1 class="sign">Diego Temkin</h1>
    ) : (
      <a class="sign" href="/">
        Diego Temkin
      </a>
    )
  }
  <p class="line">MS Transportation student at MIT, JTL-Transit Lab</p>
  <nav aria-label="Main">
    <ul>
      {
        links.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .station {
    padding-block: clamp(1.5rem, 5vw, 3.5rem) 0;
  }

  .sign {
    display: block;
    width: fit-content;
    font-size: var(--text-sign);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
  }

  .line {
    margin-top: 0.5rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }

  li a {
    display: inline-block;
    padding-block: 0.25rem;
  }
</style>
